<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche de paie — {{ employe.nomcomplet }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 13px; color: #333; padding: 30px; }

        .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 2px solid #333; padding-bottom: 15px; }
        .company h2 { font-size: 20px; font-weight: bold; }
        .company p { color: #555; font-size: 12px; }
        .doc-title { text-align: right; }
        .doc-title h1 { font-size: 18px; font-weight: bold; text-transform: uppercase; }
        .doc-title p { color: #555; font-size: 12px; }

        .section { margin-bottom: 20px; }
        .section-title { background: #f0f0f0; padding: 6px 10px; font-weight: bold; font-size: 13px; border-left: 4px solid #333; margin-bottom: 10px; }

        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 20px; padding: 0 10px; }
        .info-row { display: flex; gap: 6px; }
        .info-label { color: #666; min-width: 130px; }
        .info-value { font-weight: bold; }

        table { width: 100%; border-collapse: collapse; margin-top: 5px; }
        table th { background: #333; color: white; padding: 8px 10px; text-align: left; font-size: 12px; }
        table td { padding: 8px 10px; border-bottom: 1px solid #eee; font-size: 13px; }
        table tr:last-child td { border-bottom: none; }
        .text-right { text-align: right; }

        .total-row { background: #f9f9f9; font-weight: bold; font-size: 14px; }
        .net-row { background: #333; color: white; font-weight: bold; font-size: 15px; }

        .footer { margin-top: 40px; display: flex; justify-content: space-between; }
        .signature { text-align: center; width: 200px; }
        .signature .line { border-top: 1px solid #333; margin-top: 40px; padding-top: 5px; font-size: 12px; color: #555; }

        .no-print { margin-bottom: 20px; }
        @media print {
            .no-print { display: none; }
            body { padding: 15px; }
        }
    </style>
</head>
<body>

    <div class="no-print">
        <button onclick="window.print()" style="padding:8px 16px; background:#333; color:white; border:none; border-radius:4px; cursor:pointer; margin-right:10px;">
            Imprimer
        </button>
        <a href="{{ path('app_employe_fiche_paie_pdf', {'id': paieEmploye.id}) }}"
           style="padding:8px 16px; background:#1a7a3c; color:white; border-radius:4px; text-decoration:none;">
            Télécharger PDF
        </a>
        <a href="{{ path('app_employe_payer', {'id': employe.id}) }}"
           style="padding:8px 16px; background:#555; color:white; border-radius:4px; text-decoration:none; margin-left:10px;">
            Retour
        </a>
    </div>

    {# En-tête #}
    <div class="header">
        <div class="company">
            <h2>Credol</h2>
            <p>Bulletin de paie</p>
        </div>
        <div class="doc-title">
            <h1>Fiche de Paie</h1>
            <p>Période : {{ paieEmploye.paie.label }}</p>
            <p>Date d'émission : {{ paieEmploye.createdAt ? paieEmploye.createdAt|date('d/m/Y') : '' }}</p>
        </div>
    </div>

    {# Infos employé #}
    <div class="section">
        <div class="section-title">Informations de l'employé</div>
        <div class="info-grid">
            <div class="info-row">
                <span class="info-label">Nom complet :</span>
                <span class="info-value">{{ employe.nomcomplet }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Matricule :</span>
                <span class="info-value">{{ employe.matricule }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Titre :</span>
                <span class="info-value">{{ employe.titre }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Catégorie :</span>
                <span class="info-value">{{ employe.categorie }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Date d'embauche :</span>
                <span class="info-value">{{ employe.dateembauche ? employe.dateembauche|date('d/m/Y') : '-' }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Salaire journalier :</span>
                <span class="info-value">{{ employe.salaireJournalier|number_format(2) }}</span>
            </div>
        </div>
    </div>

    {# Détail de la paie #}
    <div class="section">
        <div class="section-title">Détail de la rémunération</div>
        <table>
            <thead>
                <tr>
                    <th>Rubrique</th>
                    <th>Base</th>
                    <th>Taux / Détail</th>
                    <th class="text-right">Montant</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Salaire de base</td>
                    <td>{{ paieEmploye.nbJours }} jour(s)</td>
                    <td>{{ employe.salaireJournalier|number_format(2) }} / jour</td>
                    <td class="text-right">{{ paieEmploye.salaireBase|number_format(2) }}</td>
                </tr>
                {% if paieEmploye.primes > 0 %}
                <tr>
                    <td>Primes</td>
                    <td>—</td>
                    <td>—</td>
                    <td class="text-right">+ {{ paieEmploye.primes|number_format(2) }}</td>
                </tr>
                {% endif %}
                {% if paieEmploye.deductions > 0 %}
                <tr>
                    <td>Déductions</td>
                    <td>—</td>
                    <td>—</td>
                    <td class="text-right">- {{ paieEmploye.deductions|number_format(2) }}</td>
                </tr>
                {% endif %}
                <tr class="net-row">
                    <td colspan="3">NET À PAYER</td>
                    <td class="text-right">{{ paieEmploye.total|number_format(2) }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    {# Signatures #}
    <div class="footer">
        <div class="signature">
            <div class="line">Signature de l'employé</div>
        </div>
        <div class="signature">
            <div class="line">Signature de l'employeur</div>
        </div>
    </div>

</body>
</html>
