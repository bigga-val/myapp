{% extends 'components/layout/default.html.twig' %}
{% block content %}
<link rel="stylesheet" href="{{ asset('assets/css/datatables.min.css') }}">

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Liste des employés</h1>
        <a class="border border-2 p-2 m2 text-white rounded bg-primary" href="{{ path('app_employe_new') }}">Nouvel Employé</a>

    </div>
</div>
<div class="panel">
    <div class="flex justify-between mb-3">
    <table class="table" data-dt>
        <thead>
            <tr>
                <th>#</th>
                <th>Matricule</th>
                <th>Nom Complet</th>
                <th>Titre</th>
                <th>Date Embauche</th>
                <th>Categorie</th>
                <th class="no-export">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for employe in employes %}
            <tr>
                <td>{{ employe.id }}</td>

                <td>{{ employe.matricule }}</td>
                <td>{{ employe.nomcomplet }}</td>
                <td>{{ employe.titre }}</td>
                <td>{{ employe.dateembauche ? employe.dateembauche|date('d-m-Y') : '' }}</td>
                <td>{{ employe.categorie }}</td>
                <td class="flex gap-1">
                    <a class="btn btn-primary btn-sm" href="{{ path('app_employe_edit', {'id': employe.id}) }}" data-tip="Modifier"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                    <a class="btn btn-success btn-sm" href="{{ path('app_employe_payer', {'id': employe.id}) }}" data-tip="Payer l'employé"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endblock %}
