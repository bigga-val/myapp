{% extends 'components/layout/default.html.twig' %}
{% block content %}
<link rel="stylesheet" href="{{ asset('assets/css/datatables.min.css') }}">

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Liste des employés</h1>
        <a class="border border-2 p-2 m2 text-white rounded bg-primary" href="{{ path('app_employe_new') }}">Nouvel Employé</a>

    </div>
</div>
<div class="panel">
    <div class="flex justify-between mb-3">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Matricule</th>
                <th>Nom Complet</th>
                <th>Titre</th>
                <th>Date Embauche</th>
                <th>Categorie</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for employe in employes %}
            <tr>
                <td>{{ employe.id }}</td>

                <td>{{ employe.matricule }}</td>
                <td>{{ employe.nomcomplet }}</td>
                <td>{{ employe.titre }}</td>
                <td>{{ employe.dateembauche ? employe.dateembauche|date('d-m-Y') : '' }}</td>
                <td>{{ employe.categorie }}</td>
                <td class="flex">
                    <a class="btn btn-primary y-1" href="{{ path('app_employe_edit', {'id': employe.id}) }}">Modifier</a>
                    <a class="btn btn-primary y-1" href="{{ path('app_employe_payer', {'id': employe.id}) }}">Payer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endblock %}
