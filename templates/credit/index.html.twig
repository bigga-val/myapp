{% extends 'components/layout/default.html.twig' %}
{% block content %}
    <link rel="stylesheet" href="{{ asset('assets/css/datatables.min.css') }}">

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Dépenses</h1>
        <a class="border border-2 p-2 m2 text-white rounded bg-primary" href="{{ path('app_credit_new') }}">Nouvelle dépense</a>

    </div>
    <div>
        <input type="text" class="form-input mb-3" id="myInput" placeholder="Rechercher..." title="Tapez ici pour rechercher">

        <table id="datatable" class="table">
            <thead>
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Montant(Fc)</th>
                <th>Montant($)</th>
                <th>Taux</th>
                <th>Cree Par</th>
                <th>Raison</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% set counter = 0 %}
            {% for credit in credits %}
                {% set counter = counter + 1 %}

                <tr>
                    <td>{{ counter }}</td>
{#                    <td>{{ credit.dateCredit ? credit.dateCredit|date('Y-m-d') : '' }}</td>#}
                    <td>{{ credit.createdAt ? credit.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ credit.montant }}</td>
                    {% set convert = 0 %}
                    {% if credit.taux is not null or credit.taux != 0 %}
                        {% set convert = credit.montant / credit.taux %}
                    {% endif %}
                    <td>{{ convert|number_format(2) }}</td>
                    <td>{{ credit.taux }}</td>
                    <td>{{ credit.createdBy }}</td>
                    <td>{{ credit.raison }}</td>
                    <td class="flex gap-1">
                        <a class="btn btn-primary btn-sm" href="{{ path('app_credit_show', {'id': credit.id}) }}" data-tip="Voir"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg></a>
                        <a class="btn btn-warning btn-sm" href="{{ path('app_credit_edit', {'id': credit.id}) }}" data-tip="Modifier"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
    <script src="{{ asset('assets/js/jquery.min.js') }}"></script>
    <script src="{{ asset('assets/js/datatables.js') }}"></script>
    <script>
        let table = new DataTable('#datatable', {
            order: [[0, 'desc']],
            language: {
                info: 'Page _PAGE_ / _PAGES_',
                infoEmpty: 'No records available',
                infoFiltered: '(filtered from _MAX_ total records)',
                lengthMenu: 'Afficher _MENU_ ligne par page',
                zeroRecords: 'Nothing found - sorry'
            },
            buttons: [
                'copy', 'excel', 'pdf'
            ]
        });
    </script>
{% endblock %}

