        /* Tooltip custom */
        .tippy-box[data-theme~='masomo'] {
            background: #1e293b;
            color: #f8fafc;
            font-size: 0.75rem;
            border-radius: 6px;
            padding: 2px 4px;
        }
        .tippy-box[data-theme~='masomo'][data-placement^='top'] > .tippy-arrow::before { border-top-color: #1e293b; }
        .tippy-box[data-theme~='masomo'][data-placement^='bottom'] > .tippy-arrow::before { border-bottom-color: #1e293b; }

        /* Button loading state */
        .btn-loading { opacity: 0.7; pointer-events: none; }
        .btn-loading::after {
            content: ' ⏳';
            font-size: 0.8em;
        }

        /* Form field hint badge */
        .field-hint {
            font-size: 0.72rem;
            color: #6b7280;
            margin-top: 2px;
            display: block;
        }

        /* Flash message progress bar */
        .flash-bar {
            height: 3px;
            background: rgba(0,0,0,0.15);
            border-radius: 0 0 4px 4px;
            animation: shrink 4s linear forwards;
        }
        @keyframes shrink { from { width: 100%; } to { width: 0%; } }
    </style>
