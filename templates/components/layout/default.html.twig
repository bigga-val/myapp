        <kbd style="background:#f3f4f6;border:1px solid #d1d5db;border-radius:3px;padding:1px 4px;font-size:0.65rem;">Alt+N</kbd> Nouveau &nbsp;
        <kbd style="background:#f3f4f6;border:1px solid #d1d5db;border-radius:3px;padding:1px 4px;font-size:0.65rem;">Alt+F</kbd> Rechercher
