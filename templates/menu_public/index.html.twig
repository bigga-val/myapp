<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Restaurant</title>
    <link rel="icon" type="image/png" href="{{ asset('assets/favicon.png') }}" />
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}" />
    <style>
        body { background: #f3f4f6; }
        .product-card { transition: transform 0.15s, box-shadow 0.15s; }
        .product-card:active { transform: scale(0.96); }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        [x-cloak] { display: none !important; }
        .step-indicator.active { background: #4361ee; color: #fff; }
        .step-indicator { background: #e5e7eb; color: #9ca3af; }
    </style>
</head>
<body x-data="menuApp()" x-cloak class="min-h-screen">

    {# ══════════════════════════════════════════════════════════════ #}
    {# ── Header ───────────────────────────────────────────────────  #}
    {# ══════════════════════════════════════════════════════════════ #}
    <div class="bg-primary text-white px-4 py-3 sticky top-0 z-20 shadow">
        <div class="flex justify-between items-center max-w-lg mx-auto">
            <div>
                <h1 class="text-base font-bold leading-tight">Notre Menu</h1>
                <p class="text-xs opacity-75">Bienvenue !</p>
            </div>
            <button @click="ouvrirPanier()" class="relative p-2 bg-white/20 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <span x-show="totalItems > 0" x-text="totalItems"
                      class="absolute -top-1 -right-1 bg-danger text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
                </span>
            </button>
        </div>
    </div>

    {# ══════════════════════════════════════════════════════════════ #}
    {# ── Category tabs ────────────────────────────────────────────  #}
    {# ══════════════════════════════════════════════════════════════ #}
    {% if menu is not empty %}
    <div class="bg-white border-b shadow-sm sticky top-[56px] z-10 overflow-x-auto">
        <div class="flex gap-2 px-4 py-2 max-w-lg mx-auto" style="width: max-content; min-width: 100%;">
            {% for item in menu %}
            <a href="#cat-{{ item.categorie.id }}"
               class="px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors">
                {{ item.categorie.designation }}
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ══════════════════════════════════════════════════════════════ #}
    {# ── Produits ─────────────────────────────────────────────────  #}
    {# ══════════════════════════════════════════════════════════════ #}
    <div class="max-w-lg mx-auto px-4 pt-4 pb-32">
        {% for item in menu %}
        <div id="cat-{{ item.categorie.id }}" class="mb-8">
            <h2 class="flex items-center gap-2 text-sm font-bold text-gray-700 mb-3">
                <span class="w-1 h-5 bg-primary rounded-full"></span>
                {{ item.categorie.designation }}
            </h2>
            <div class="grid grid-cols-2 gap-3">
                {% for produit in item.produits %}
                <div class="product-card relative bg-white rounded-xl shadow-sm overflow-hidden cursor-pointer border border-transparent hover:border-primary/30"
                     :class="getQty({{ produit.id }}) > 0 ? 'border-primary/40 shadow-md' : ''"
                     @click="addToCart({{ produit.id }}, '{{ produit.designation|e('js') }}', {{ produit.prix ?? 0 }})">

                    {# Badge compteur — visible quand qty > 0 #}
                    <div x-show="getQty({{ produit.id }}) > 0"
                         x-text="getQty({{ produit.id }})"
                         class="absolute top-2 right-2 z-10 bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center shadow-lg">
                    </div>

                    {% if produit.image %}
                    <img src="{{ asset('uploads/' ~ produit.image) }}"
                         alt="{{ produit.designation }}"
                         class="w-full h-28 object-cover"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="w-full h-28 bg-gray-50 items-center justify-center hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14"/>
                        </svg>
                    </div>
                    {% else %}
                    <div class="w-full h-28 bg-gray-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14"/>
                        </svg>
                    </div>
                    {% endif %}

                    <div class="p-2">
                        <p class="text-xs font-semibold text-gray-800 line-clamp-2 leading-snug">{{ produit.designation }}</p>
                        <p class="text-sm font-bold text-primary mt-1">
                            {{ produit.prix ? produit.prix|number_format(0, ',', '.') ~ ' FC' : 'Prix N/A' }}
                        </p>

                        {# Bouton simple quand pas encore dans le panier #}
                        <div x-show="getQty({{ produit.id }}) === 0"
                             class="mt-2 w-full text-center text-xs bg-primary/10 text-primary py-1 rounded-lg font-medium">
                            + Ajouter
                        </div>

                        {# Contrôles +/- quand déjà dans le panier #}
                        <div x-show="getQty({{ produit.id }}) > 0"
                             class="mt-2 flex items-center justify-between bg-primary/5 rounded-lg px-1 py-0.5"
                             @click.stop>
                            <button @click="decreaseQty({{ produit.id }})"
                                    class="w-7 h-7 rounded-full bg-white shadow-sm flex items-center justify-center font-bold text-gray-600 text-base leading-none">
                                −
                            </button>
                            <span class="font-bold text-sm text-primary" x-text="getQty({{ produit.id }})"></span>
                            <button @click="increaseQty({{ produit.id }})"
                                    class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-base leading-none">
                                +
                            </button>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% else %}
        <div class="text-center py-20 text-gray-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto mb-4 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <p class="font-medium text-gray-500">Le menu n'est pas encore disponible</p>
            <p class="text-sm mt-1 text-gray-400">Revenez bientôt !</p>
        </div>
        {% endfor %}
    </div>

    {# ══════════════════════════════════════════════════════════════ #}
    {# ── Barre commande flottante ──────────────────────────────────  #}
    {# ══════════════════════════════════════════════════════════════ #}
    <div x-show="cart.length > 0"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         class="fixed bottom-0 left-0 right-0 p-3 bg-white border-t shadow-xl z-20">
        <div class="max-w-lg mx-auto">
            <button @click="ouvrirPanier()"
                    class="w-full flex justify-between items-center bg-primary text-white py-3 px-4 rounded-xl font-semibold">
                <span class="bg-white/25 rounded-lg px-2 py-0.5 text-sm" x-text="totalItems + ' article(s)'"></span>
                <span class="text-sm">Ma commande</span>
                <span class="text-sm font-bold" x-text="formatPrice(totalPrice) + ' FC'"></span>
            </button>
        </div>
    </div>

    {# ══════════════════════════════════════════════════════════════ #}
    {# ── Drawer multi-étapes ───────────────────────────────────────  #}
    {# ══════════════════════════════════════════════════════════════ #}
    <div x-show="drawerOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         class="fixed inset-0 z-50"
         @click.self="drawerOpen = false">
        <div class="absolute inset-0 bg-black/50" @click="drawerOpen = false"></div>

        <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl max-h-[90vh] flex flex-col shadow-2xl"
             x-transition:enter="transition ease-out duration-250"
             x-transition:enter-start="translate-y-full"
             x-transition:enter-end="translate-y-0"
             @click.stop>

            {# Header du drawer avec étapes #}
            <div class="px-5 py-4 border-b">
                <div class="flex justify-between items-center mb-3">
                    <button x-show="step > 1" @click="step--"
                            class="text-gray-400 hover:text-gray-600 flex items-center gap-1 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                        Retour
                    </button>
                    <span x-show="step === 1" class="font-bold text-base">Ma commande</span>
                    <span x-show="step === 2" class="font-bold text-base">Choisir ma table</span>
                    <span x-show="step === 3" class="font-bold text-base">Mes informations</span>
                    <button @click="drawerOpen = false" class="text-gray-400 hover:text-gray-600 text-2xl leading-none font-light ml-auto">×</button>
                </div>

                {# Indicateurs d'étapes #}
                <div class="flex gap-1.5 justify-center">
                    <template x-for="i in 3" :key="i">
                        <div class="h-1.5 rounded-full transition-all duration-300"
                             :class="i <= step ? 'bg-primary' : 'bg-gray-200'"
                             :style="i === step ? 'width: 32px' : 'width: 16px'"></div>
                    </template>
                </div>
            </div>

            {# ── Étape 1 : Panier ─────────────────────────────────── #}
            <div x-show="step === 1" class="overflow-y-auto flex-1 px-5">
                <template x-if="cart.length === 0">
                    <div class="text-center py-12 text-gray-400">
                        <p class="text-4xl mb-2">🛒</p>
                        <p class="text-sm">Votre panier est vide</p>
                    </div>
                </template>
                <template x-for="item in cart" :key="item.id">
                    <div class="flex items-center gap-3 py-3 border-b last:border-0">
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-sm truncate" x-text="item.nom"></p>
                            <p class="text-primary text-sm font-semibold" x-text="formatPrice(item.prix * item.qty) + ' FC'"></p>
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <button @click="decreaseQty(item.id)"
                                    class="w-7 h-7 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center font-bold text-gray-600">−</button>
                            <span class="w-6 text-center font-bold text-sm" x-text="item.qty"></span>
                            <button @click="increaseQty(item.id)"
                                    class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-bold">+</button>
                        </div>
                    </div>
                </template>
            </div>
            <div x-show="step === 1" class="px-5 py-4 border-t bg-gray-50">
                <div class="flex justify-between font-bold text-base mb-4">
                    <span>Total</span>
                    <span class="text-primary" x-text="formatPrice(totalPrice) + ' FC'"></span>
                </div>
                <button @click="step = 2" :disabled="cart.length === 0"
                        class="w-full bg-primary text-white py-3 rounded-xl font-bold text-sm disabled:opacity-40">
                    Continuer →
                </button>
            </div>

            {# ── Étape 2 : Choix de la table ──────────────────────── #}
            <div x-show="step === 2" class="overflow-y-auto flex-1 px-5 py-4">
                <p class="text-sm text-gray-500 mb-4">Sur quelle table êtes-vous assis(e) ?</p>
                <div class="grid grid-cols-2 gap-2">
                    {% for table in tables %}
                    <button @click="tableId = {{ table.id }}; tableNom = '{{ table.designation|e('js') }}'"
                            :class="tableId === {{ table.id }} ? 'border-primary bg-primary/10 text-primary font-bold' : 'border-gray-200 bg-white text-gray-700'"
                            class="py-4 rounded-xl border-2 text-sm font-medium transition-colors">
                        {{ table.designation }}
                    </button>
                    {% else %}
                    <p class="col-span-2 text-center text-gray-400 py-6">Aucune table disponible.</p>
                    {% endfor %}
                </div>
            </div>
            <div x-show="step === 2" class="px-5 py-4 border-t bg-gray-50">
                <button @click="step = 3" :disabled="!tableId"
                        class="w-full bg-primary text-white py-3 rounded-xl font-bold text-sm disabled:opacity-40">
                    Continuer →
                </button>
            </div>

            {# ── Étape 3 : Infos client ───────────────────────────── #}
            <div x-show="step === 3" class="overflow-y-auto flex-1 px-5 py-4">
                <div class="bg-gray-50 rounded-xl p-3 mb-5 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-500">Table</span>
                        <span class="font-semibold" x-text="tableNom"></span>
                    </div>
                    <div class="flex justify-between mt-1">
                        <span class="text-gray-500">Total</span>
                        <span class="font-semibold text-primary" x-text="formatPrice(totalPrice) + ' FC'"></span>
                    </div>
                </div>

                <p class="text-sm text-gray-500 mb-4">
                    Pour votre confort et notre programme de fidélité, laissez vos coordonnées.
                    <span class="text-gray-400">(optionnel)</span>
                </p>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Votre nom</label>
                        <input x-model="clientNom" type="text" placeholder="Ex : Jean Dupont"
                               class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Votre numéro de téléphone</label>
                        <input x-model="clientTel" type="tel" placeholder="Ex : +243 81 234 5678"
                               class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                    </div>
                </div>
            </div>
            <div x-show="step === 3" class="px-5 py-4 border-t bg-gray-50">
                <button @click="passerCommande()" :disabled="loading"
                        class="w-full bg-success text-white py-3 rounded-xl font-bold text-sm disabled:opacity-50 flex items-center justify-center gap-2">
                    <span x-show="!loading">Envoyer ma commande ✓</span>
                    <span x-show="loading" class="flex items-center gap-2">
                        <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                        </svg>
                        Envoi...
                    </span>
                </button>
            </div>
        </div>
    </div>

    {# ══════════════════════════════════════════════════════════════ #}
    {# ── Confirmation ─────────────────────────────────────────────  #}
    {# ══════════════════════════════════════════════════════════════ #}
    <div x-show="success"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/60"></div>
        <div class="relative bg-white rounded-2xl p-8 text-center max-w-xs w-full shadow-2xl">
            <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <h3 class="font-bold text-xl mb-1">Commande envoyée !</h3>
            <p class="text-gray-500 text-sm mb-1">Numéro de commande</p>
            <p class="text-primary font-bold text-lg mb-1" x-text="numeroVente"></p>
            <p class="text-gray-500 text-xs mb-1">Table : <span class="font-semibold" x-text="tableNom"></span></p>
            <template x-if="clientNom">
                <p class="text-gray-500 text-xs mb-4">Client : <span class="font-semibold" x-text="clientNom"></span></p>
            </template>
            <p class="text-xs text-gray-400 mb-6">Votre commande a été transmise. L'équipe vous servira bientôt. Merci !</p>
            <button @click="resetApp()"
                    class="w-full bg-primary text-white py-3 rounded-xl font-bold text-sm">
                Nouvelle commande
            </button>
        </div>
    </div>

    {# Notification d'erreur #}
    <div x-show="errorMsg" x-transition
         class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-danger text-white px-5 py-3 rounded-xl shadow-lg text-sm font-medium max-w-xs text-center">
        <span x-text="errorMsg"></span>
    </div>

    <script src="{{ asset('assets/js/alpine-collaspe.min.js') }}"></script>
    <script src="{{ asset('assets/js/alpine-persist.min.js') }}"></script>
    <script defer src="{{ asset('assets/js/alpine.min.js') }}"></script>

    <script>
        const COMMANDER_URL = '{{ path('app_menu_commander') }}';

        function menuApp() {
            return {
                cart: [],
                drawerOpen: false,
                step: 1,           // 1=panier, 2=table, 3=client
                tableId: null,
                tableNom: '',
                clientNom: '',
                clientTel: '',
                loading: false,
                success: false,
                numeroVente: '',
                errorMsg: '',

                get totalItems() {
                    return this.cart.reduce((sum, i) => sum + i.qty, 0);
                },
                get totalPrice() {
                    return this.cart.reduce((sum, i) => sum + i.prix * i.qty, 0);
                },

                formatPrice(v) {
                    return Math.round(v).toLocaleString('fr-FR');
                },

                getQty(id) {
                    const item = this.cart.find(i => i.id === id);
                    return item ? item.qty : 0;
                },

                addToCart(id, nom, prix) {
                    const existing = this.cart.find(i => i.id === id);
                    if (existing) {
                        existing.qty++;
                    } else {
                        this.cart.push({ id, nom, prix, qty: 1 });
                    }
                },

                increaseQty(id) {
                    const item = this.cart.find(i => i.id === id);
                    if (item) item.qty++;
                },

                decreaseQty(id) {
                    const item = this.cart.find(i => i.id === id);
                    if (!item) return;
                    item.qty--;
                    if (item.qty <= 0) this.cart = this.cart.filter(i => i.id !== id);
                },

                ouvrirPanier() {
                    this.step = 1;
                    this.drawerOpen = true;
                },

                async passerCommande() {
                    if (!this.tableId || this.cart.length === 0) return;
                    this.loading = true;
                    this.errorMsg = '';
                    try {
                        const res = await fetch(COMMANDER_URL, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                items:     this.cart.map(i => ({ produitId: i.id, qty: i.qty })),
                                tableId:   this.tableId,
                                clientNom: this.clientNom,
                                clientTel: this.clientTel,
                            })
                        });
                        const data = await res.json();
                        if (data.etat) {
                            this.drawerOpen = false;
                            this.numeroVente = data.numeroVente;
                            this.success = true;
                        } else {
                            this.showError(data.message || 'Erreur lors de la commande.');
                        }
                    } catch (e) {
                        this.showError('Connexion impossible. Vérifiez votre réseau.');
                    } finally {
                        this.loading = false;
                    }
                },

                showError(msg) {
                    this.errorMsg = msg;
                    setTimeout(() => { this.errorMsg = ''; }, 4000);
                },

                resetApp() {
                    this.cart       = [];
                    this.success    = false;
                    this.numeroVente = '';
                    this.step       = 1;
                    this.tableId    = null;
                    this.tableNom   = '';
                    this.clientNom  = '';
                    this.clientTel  = '';
                }
            };
        }
    </script>
</body>
</html>
