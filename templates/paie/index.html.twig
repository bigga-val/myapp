{% extends 'components/layout/default.html.twig' %}

{% block content %}
<div class="panel">
    <div class="flex justify-between items-center mb-4">
        <div>
            <h1 class="text-xl font-bold">Fiches de paie</h1>
            <p class="text-sm text-gray-500 mt-0.5">Gestion des paies du personnel</p>
        </div>
        <a href="{{ path('app_paie_new') }}" class="btn btn-primary btn-sm flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Nouvelle paie
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover text-sm">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Libellé</th>
                    <th>Mois</th>
                    <th>Année</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for paie in paies %}
                <tr>
                    <td class="text-gray-400 text-xs">{{ paie.id }}</td>
                    <td class="font-medium">{{ paie.label }}</td>
                    <td>{{ paie.MonthPay }}</td>
                    <td>{{ paie.YearPay }}</td>
                    <td class="text-right">
                        <div class="flex justify-end gap-1">
                            <a href="{{ path('app_paie_show', {'id': paie.id}) }}"
                               class="btn btn-primary btn-sm px-2"
                               data-tip="Voir le détail">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </a>
                            <a href="{{ path('app_paie_edit', {'id': paie.id}) }}"
                               class="btn btn-warning btn-sm px-2"
                               data-tip="Modifier">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125L18 8.625"/>
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-gray-400 py-8">Aucune fiche de paie enregistrée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
