{% extends 'components/layout/default.html.twig' %}

{% block content %}
<div class="mb-4 flex flex-wrap justify-between items-center gap-3">
    <div>
        <h1 class="text-xl font-bold flex items-center gap-2">
            Commandes en attente
            {% if ventes is not empty %}
            <span class="bg-danger text-white text-sm font-bold px-2.5 py-0.5 rounded-full">{{ ventes|length }}</span>
            {% endif %}
        </h1>
        <p class="text-sm text-gray-500 mt-0.5">
            Commandes reçues non encore traitées — toutes sources confondues.
        </p>
    </div>
    <div class="flex items-center gap-3">
        {# Indicateur de rafraîchissement #}
        <div class="flex items-center gap-2 text-xs text-gray-400">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
            </span>
            Actualisation dans <span id="countdown" class="font-semibold text-gray-600">120</span>s
        </div>
        <button onclick="window.location.reload()" class="btn btn-outline-primary btn-sm">
            Actualiser
        </button>
    </div>
</div>

{% if ventes is empty %}
<div class="panel text-center py-16">
    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
    </div>
    <p class="text-lg font-bold text-gray-700">Aucune commande en attente</p>
    <p class="text-sm text-gray-400 mt-1">Toutes les commandes ont été traitées.</p>
</div>
{% else %}

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
{% for vente in ventes %}
{% set produits = produitsParVente[vente.id] ?? [] %}
{% set total = 0 %}
{% for p in produits %}{% set total = total + (p.qty * p.prixUnitaire) %}{% endfor %}

<div class="panel border-l-4 {{ vente.clientNom ? 'border-l-primary' : 'border-l-warning' }} !p-0 overflow-hidden" id="card-{{ vente.id }}">

    {# ── Entête de la carte ──────────────────────────────────────── #}
    <div class="px-4 py-3 bg-gray-50 border-b flex justify-between items-start">
        <div>
            <div class="flex items-center gap-2">
                <span class="font-bold text-base text-gray-800">{{ vente.numeroVente }}</span>
                {% if vente.clientNom %}
                <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full font-medium">Menu QR</span>
                {% else %}
                <span class="text-xs bg-warning/10 text-warning px-2 py-0.5 rounded-full font-medium">Caisse</span>
                {% endif %}
            </div>
            <p class="text-xs text-gray-400 mt-0.5">
                {% if vente.createdAt %}
                    {{ vente.createdAt|date('H:i') }} —
                    {% set diffMin = ((date()|date('U')) - (vente.createdAt|date('U'))) // 60 %}
                    {% if diffMin < 1 %}
                        à l'instant
                    {% elseif diffMin < 60 %}
                        il y a {{ diffMin }} min
                    {% else %}
                        il y a {{ (diffMin // 60) }}h{{ '%02d'|format(diffMin % 60) }}
                    {% endif %}
                {% endif %}
            </p>
        </div>
        <a href="{{ path('app_vente_show', {'id': vente.id}) }}"
           class="text-xs text-primary underline">Détails</a>
    </div>

    {# ── Infos table + client ────────────────────────────────────── #}
    <div class="px-4 py-3 border-b space-y-1">
        <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 10h18M3 6h18M3 14h18M3 18h18"/>
            </svg>
            <span class="font-semibold text-gray-700">
                {{ vente.tableServie ? 'Table ' ~ vente.tableServie.designation : 'Table non précisée' }}
            </span>
        </div>
        {% if vente.clientNom %}
        <div class="flex items-center gap-2 text-sm text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span>{{ vente.clientNom }}</span>
        </div>
        {% endif %}
        {% if vente.clientTel %}
        <div class="flex items-center gap-2 text-sm text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:{{ vente.clientTel }}" class="text-primary hover:underline">{{ vente.clientTel }}</a>
        </div>
        {% endif %}
    </div>

    {# ── Liste des produits ──────────────────────────────────────── #}
    <div class="px-4 py-3 border-b">
        {% if produits is empty %}
        <p class="text-xs text-gray-400 italic">Aucun article</p>
        {% else %}
        <ul class="space-y-1">
            {% for p in produits %}
            <li class="flex justify-between text-sm">
                <span class="text-gray-700">
                    <span class="font-semibold text-primary mr-1">×{{ p.qty }}</span>
                    {{ p.produit.designation }}
                </span>
                <span class="text-gray-500 font-medium">{{ (p.qty * p.prixUnitaire)|number_format(0, ',', '.') }} FC</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>

    {# ── Total + actions ─────────────────────────────────────────── #}
    <div class="px-4 py-3">
        <div class="flex justify-between items-center mb-3">
            <span class="text-sm font-semibold text-gray-600">Total</span>
            <span class="text-base font-bold text-primary">{{ total|number_format(0, ',', '.') }} FC</span>
        </div>
        <div class="flex gap-2">
            <form method="POST" action="{{ path('app_vente_payer_rapide', {'id': vente.id}) }}" class="flex-1"
                  onsubmit="return confirm('Confirmer le paiement de {{ vente.numeroVente }} ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('payer' ~ vente.id) }}">
                <button type="submit"
                        class="w-full btn btn-success btn-sm flex items-center justify-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Payé
                </button>
            </form>
            <form method="POST" action="{{ path('app_vente_rejeter', {'id': vente.id}) }}"
                  onsubmit="return confirm('Annuler la commande {{ vente.numeroVente }} ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('rejeter' ~ vente.id) }}">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    Annuler
                </button>
            </form>
        </div>
    </div>
</div>
{% endfor %}
</div>
{% endif %}

<script>
    const INITIAL_COUNT = {{ ventes|length }};
    let seconds = 120;

    // Décompte + vérification des nouvelles commandes
    const tick = setInterval(async () => {
        seconds--;
        document.getElementById('countdown').textContent = seconds;

        if (seconds <= 0) {
            clearInterval(tick);
            try {
                const res  = await fetch('{{ path('app_vente_pending_count') }}');
                const data = await res.json();
                if (data.count !== INITIAL_COUNT) {
                    playBeep();
                }
            } catch (e) {}
            window.location.reload();
        }
    }, 1000);

    // Bip sonore si nouvelle commande
    function playBeep() {
        try {
            const ctx  = new (window.AudioContext || window.webkitAudioContext)();
            const osc  = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.frequency.value = 880;
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.4);
        } catch (e) {}
    }
</script>
{% endblock %}
