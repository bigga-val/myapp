{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Années académiques</h1>
        <a class="btn btn-primary" href="{{ path('app_annee_academique_new') }}">Nouvelle année</a>
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-hover" data-dt>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Libellé</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Statut</th>
                    <th class="no-export">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for annee in annees %}
                <tr>
                    <td>{{ annee.id }}</td>
                    <td>{{ annee.libelle }}</td>
                    <td>{{ annee.dateDebut ? annee.dateDebut|date('d/m/Y') : '' }}</td>
                    <td>{{ annee.dateFin ? annee.dateFin|date('d/m/Y') : '' }}</td>
                    <td>
                        {% if annee.isCurrent %}
                            <span class="badge bg-success text-white px-2 py-1 rounded">En cours</span>
                        {% else %}
                            <span class="badge bg-secondary text-white px-2 py-1 rounded">Inactive</span>
                        {% endif %}
                    </td>
                    <td class="flex gap-1">
                        <a class="btn btn-primary btn-sm" href="{{ path('app_annee_academique_edit', {'id': annee.id}) }}" data-tip="Modifier"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>

                        {% if not annee.isCurrent %}
                        <form method="post" action="{{ path('app_annee_academique_activer', {'id': annee.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('activer' ~ annee.id) }}">
                            <button class="btn btn-warning btn-sm" type="submit" data-tip="Activer cette année" onclick="return confirm('Activer cette année académique ?')"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></button>
                        </form>
                        {% endif %}

                        <form method="post" action="{{ path('app_annee_academique_delete', {'id': annee.id}) }}" style="display:inline">
                            <input type="hidden" name="_method" value="POST">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ annee.id) }}">
                            <button class="btn btn-danger btn-sm" type="submit" data-tip="Supprimer" onclick="return confirm('Supprimer cette année académique ?')"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucune année académique trouvée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
