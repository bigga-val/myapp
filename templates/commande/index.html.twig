{% extends 'components/layout/default.html.twig' %}
{% block content %}
    <link rel="stylesheet" href="{{ asset('assets/css/datatables.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/buttons.dataTables.min.css') }}">
<div class="panel">
    <div class="flex justify-between items-center mb-4">
        <h1>Liste des Commandes</h1>
        <div class="flex gap-2 items-center">
            <div id="export-buttons"></div>
            <a class="border border-2 p-2 text-white rounded bg-primary" href="{{ path('app_commander') }}">Nouvelle Commande</a>
        </div>
    </div>

    <table id="datatable" class="table display">
        <thead>
            <tr>
                <th>#</th>
                <th>No Commande</th>
                <th>Date</th>
                <th>Commandé par</th>
                <th>Status</th>
                <th>Approbation</th>
                <th>Approuvé par</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for commande in commandes %}
            <tr>
                <td>{{ commande.id }}</td>
                <td>{{ commande.CommandeNumber }}</td>
                <td data-order="{{ commande.CommandeDate ? commande.CommandeDate|date('Y-m-d H:i:s') : '' }}">
                    {{ commande.CommandeDate ? commande.CommandeDate|date('d/m/Y H:i') : '—' }}
                </td>
                <td>
                    {% if commande.CommandePar is not null %}
                        {{ commande.CommandePar.username }}
                    {% else %}
                        —
                    {% endif %}
                </td>
                <td>
                    {% if commande.status == 'draft' %}
                        <span class="badge bg-warning text-dark">Brouillon</span>
                    {% elseif commande.status == 'submitted' %}
                        <span class="badge bg-primary">Soumis</span>
                    {% elseif commande.status == 'cancelled' %}
                        <span class="badge bg-danger">Annulé</span>
                    {% else %}
                        <span class="badge bg-secondary">{{ commande.status ?? '—' }}</span>
                    {% endif %}
                </td>
                <td>
                    {% if commande.IsApproved is null %}
                        <span class="badge bg-warning text-dark">En attente</span>
                    {% elseif commande.IsApproved == true %}
                        <span class="badge bg-success">Approuvé</span>
                    {% else %}
                        <span class="badge bg-danger">Rejeté</span>
                    {% endif %}
                </td>
                <td>
                    {% if commande.ApprovedBy is not null %}
                        {{ commande.ApprovedBy.username }}
                    {% else %}
                        —
                    {% endif %}
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" href="{{ path('app_commande_show', {'id': commande.id}) }}">Détails</a>
                    <a class="btn btn-sm btn-secondary" href="{{ path('app_commande_reception_liste', {'commandeID': commande.id}) }}">Réceptions</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center">Aucune commande trouvée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<script src="{{ asset('assets/js/jquery.min.js') }}"></script>
<script src="{{ asset('assets/js/datatables.js') }}"></script>
<script src="{{ asset('assets/js/jszip.min.js') }}"></script>
<script src="{{ asset('assets/js/dataTables.buttons.min.js') }}"></script>
<script src="{{ asset('assets/js/buttons.html5.min.js') }}"></script>

<script>
    let table = new DataTable('#datatable', {
        order: [[0, 'desc']],
        dom: '<"flex justify-between"lf>rtip',
        initComplete: function () {
            this.api().buttons().container().appendTo('#export-buttons');
        },
        language: {
            info: 'Page _PAGE_ / _PAGES_',
            infoEmpty: 'Aucune ligne trouvée',
            infoFiltered: '(filtré sur _MAX_ entrées)',
            lengthMenu: 'Afficher _MENU_ lignes par page',
            zeroRecords: 'Aucun résultat',
            search: 'Rechercher :'
        },
        buttons: [
            {
                extend: 'copy',
                text: 'Copier',
                className: 'btn btn-sm btn-secondary',
                exportOptions: { columns: ':not(:last-child)' }
            },
            {
                extend: 'excel',
                text: 'Excel',
                className: 'btn btn-sm btn-success',
                filename: 'Liste des commandes',
                exportOptions: { columns: ':not(:last-child)' }
            },
            {
                extend: 'csv',
                text: 'CSV',
                className: 'btn btn-sm btn-info',
                filename: 'Liste des commandes',
                exportOptions: { columns: ':not(:last-child)' }
            },
            {
                extend: 'pdf',
                text: 'PDF',
                className: 'btn btn-sm btn-danger',
                filename: 'Liste des commandes',
                title: 'Liste des commandes',
                exportOptions: { columns: ':not(:last-child)' }
            }
        ]
    });
</script>

{% endblock %}
