{% extends 'components/layout/auth.html.twig' %}
{% block title %}Connexion — INSOFT MASOMO{% endblock %}

{% block content %}
<style>
    html, body { height: 100%; overflow: hidden; }
    .main-container { height: 100%; min-height: unset; }

    .login-left {
        background: linear-gradient(145deg, #0f2942 0%, #1a4f7a 50%, #0e7490 100%);
    }

    .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.15;
    }

    .input-field {
        width: 100%;
        border-radius: 10px;
        border: 1.5px solid #e5e7eb;
        background: #f9fafb;
        padding: 10px 14px 10px 42px;
        font-size: 0.875rem;
        color: #111827;
        outline: none;
        transition: all .2s;
    }
    .input-field::placeholder { color: #9ca3af; }
    .input-field:focus {
        border-color: #1a4f7a;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(26,79,122,0.12);
    }
    .input-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        width: 16px; height: 16px;
    }
    .btn-login {
        width: 100%;
        border-radius: 10px;
        background: linear-gradient(135deg, #0f2942, #1a4f7a);
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 11px;
        border: none;
        cursor: pointer;
        transition: opacity .2s, transform .1s;
        letter-spacing: 0.02em;
    }
    .btn-login:hover { opacity: 0.92; }
    .btn-login:active { transform: scale(.985); }

    .module-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 12px;
        padding: 10px 14px;
        backdrop-filter: blur(4px);
    }
    .module-pill span.icon {
        width: 32px; height: 32px;
        border-radius: 8px;
        background: rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; flex-shrink: 0;
    }
    .module-pill span.label {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.85);
        font-weight: 500;
    }

    .level-badge {
        display: inline-block;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.7);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 20px;
    }
</style>

<div class="flex h-full overflow-hidden">

    {# ══════════════════════════════════════════════════════
       COLONNE GAUCHE — Branding
    ══════════════════════════════════════════════════════ #}
    <div class="login-left hidden lg:flex lg:w-[55%] flex-col justify-between px-14 py-12 relative overflow-hidden">

        {# Blobs décoratifs #}
        <div class="blob w-72 h-72 bg-cyan-400   top-[-60px]   left-[-60px]"></div>
        <div class="blob w-96 h-96 bg-blue-300   bottom-[-80px] right-[-80px]"></div>
        <div class="blob w-48 h-48 bg-teal-300   top-[40%]      right-[-30px]"></div>

        {# Logo & titre #}
        <div class="relative z-10">
            <div class="flex items-center gap-4 mb-3">
                <div style="width:52px;height:52px;border-radius:14px;background:rgba(255,255,255,0.15);
                            display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);">
                    <svg width="26" height="26" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 3L2 9l10 6 10-6-10-6z" fill="white" opacity="0.95"/>
                        <path d="M2 15l10 6 10-6" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 12l10 6 10-6" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
                    </svg>
                </div>
                <div>
                    <div style="font-size:1.35rem;font-weight:800;color:#fff;letter-spacing:0.03em;line-height:1.1;">
                        INSOFT MASOMO
                    </div>
                    <div style="font-size:0.68rem;color:rgba(255,255,255,0.55);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">
                        Système de gestion scolaire
                    </div>
                </div>
            </div>
        </div>

        {# Tagline centrale #}
        <div class="relative z-10 text-center">
            <h2 style="font-size:2rem;font-weight:800;color:#fff;line-height:1.25;margin-bottom:10px;">
                Gérez votre école<br/>
                <span style="color:rgba(255,255,255,0.6);">en toute simplicité</span>
            </h2>
            <p style="font-size:0.85rem;color:rgba(255,255,255,0.5);max-width:340px;margin:0 auto 32px;">
                De la maternelle à l'université — un seul outil pour tout piloter.
            </p>

            {# Modules #}
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:400px;margin:0 auto;">
                <div class="module-pill">
                    <span class="icon">👩‍🎓</span>
                    <span class="label">Élèves & inscriptions</span>
                </div>
                <div class="module-pill">
                    <span class="icon">📋</span>
                    <span class="label">Notes & bulletins</span>
                </div>
                <div class="module-pill">
                    <span class="icon">🗓️</span>
                    <span class="label">Emploi du temps</span>
                </div>
                <div class="module-pill">
                    <span class="icon">✅</span>
                    <span class="label">Présences</span>
                </div>
                <div class="module-pill">
                    <span class="icon">💳</span>
                    <span class="label">Frais scolaires</span>
                </div>
                <div class="module-pill">
                    <span class="icon">📖</span>
                    <span class="label">Bibliothèque</span>
                </div>
            </div>
        </div>

        {# Niveaux #}
        <div class="relative z-10 text-center">
            <p style="font-size:0.7rem;color:rgba(255,255,255,0.35);margin-bottom:8px;letter-spacing:0.05em;text-transform:uppercase;">
                Niveaux couverts
            </p>
            <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
                <span class="level-badge">Maternelle</span>
                <span class="level-badge">Primaire</span>
                <span class="level-badge">Secondaire</span>
                <span class="level-badge">Universitaire</span>
            </div>
        </div>
    </div>

    {# ══════════════════════════════════════════════════════
       COLONNE DROITE — Formulaire
    ══════════════════════════════════════════════════════ #}
    <div class="w-full lg:w-[45%] flex flex-col justify-center items-center px-8 py-12 bg-white">
        <div style="width:100%;max-width:380px;">

            {# Header mobile #}
            <div class="lg:hidden text-center mb-8">
                <div style="font-size:1.4rem;font-weight:800;color:#0f2942;letter-spacing:0.02em;">INSOFT MASOMO</div>
                <div style="font-size:0.7rem;color:#9ca3af;letter-spacing:0.1em;text-transform:uppercase;margin-top:3px;">
                    Système de gestion scolaire
                </div>
            </div>

            {# Titre #}
            <div style="margin-bottom:28px;">
                <h1 style="font-size:1.6rem;font-weight:800;color:#111827;margin-bottom:4px;">Connexion</h1>
                <p style="font-size:0.85rem;color:#6b7280;">Accédez à votre espace de travail</p>
            </div>

            {# Erreur #}
            {% if error %}
            <div style="display:flex;align-items:flex-start;gap:10px;background:#fef2f2;border:1px solid #fecaca;
                        border-radius:10px;padding:12px 14px;margin-bottom:18px;">
                <svg style="width:16px;height:16px;color:#ef4444;flex-shrink:0;margin-top:1px;" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <span style="font-size:0.8rem;color:#b91c1c;">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
            {% endif %}

            {% if app.user %}
            <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px 14px;margin-bottom:18px;font-size:0.82rem;color:#1d4ed8;">
                Connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                <a href="{{ path('app_logout') }}" style="text-decoration:underline;margin-left:6px;">Déconnecter</a>
            </div>
            {% endif %}

            {# Formulaire #}
            <form method="post" style="display:flex;flex-direction:column;gap:18px;">

                <div>
                    <label for="inputUsername" style="display:block;font-size:0.82rem;font-weight:600;color:#374151;margin-bottom:6px;">
                        Nom d'utilisateur
                    </label>
                    <div style="position:relative;">
                        <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <input
                            type="text"
                            value="{{ last_username }}"
                            name="username"
                            id="inputUsername"
                            class="input-field"
                            placeholder="Entrez votre identifiant"
                            autocomplete="username"
                            required autofocus
                        />
                    </div>
                </div>

                <div>
                    <label for="inputPassword" style="display:block;font-size:0.82rem;font-weight:600;color:#374151;margin-bottom:6px;">
                        Mot de passe
                    </label>
                    <div style="position:relative;">
                        <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        <input
                            type="password"
                            name="password"
                            id="inputPassword"
                            class="input-field"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            required
                        />
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />
                    </div>
                </div>

                <button type="submit" class="btn-login" style="margin-top:4px;">
                    Se connecter →
                </button>

            </form>

            {# Footer #}
            <div style="margin-top:36px;text-align:center;border-top:1px solid #f3f4f6;padding-top:20px;">
                <p style="font-size:0.72rem;color:#9ca3af;line-height:1.7;">
                    &copy; {{ "now"|date("Y") }} <strong style="color:#6b7280;">INSOFT MASOMO</strong> · Tous droits réservés<br/>
                    Développé par <a href="https://insoftware.tech" target="_blank" rel="noopener noreferrer"
                        style="color:#1a4f7a;font-weight:600;text-decoration:none;">InSoftware SARL</a>
                </p>
            </div>

        </div>
    </div>

</div>
{% endblock %}
