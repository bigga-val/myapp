{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Bulletins scolaires</h1>
    </div>
</div>

<div class="panel">
    <form method="get" class="mb-4">
        <div class="flex gap-2 items-center flex-wrap">
            <label class="form-label mb-0">Classe :</label>
            <select name="classeId" class="form-select w-auto">
                <option value="">Toutes les classes</option>
                {% for classe in classes %}
                    <option value="{{ classe.id }}" {% if classeId == classe.id ~ '' %}selected{% endif %}>
                        {{ classe.nom }}
                    </option>
                {% endfor %}
            </select>
            <label class="form-label mb-0">Période :</label>
            <select name="periode" class="form-select w-auto">
                <option value="0">Toutes</option>
                <option value="1" {% if periode == 1 %}selected{% endif %}>1er Trimestre</option>
                <option value="2" {% if periode == 2 %}selected{% endif %}>2ème Trimestre</option>
                <option value="3" {% if periode == 3 %}selected{% endif %}>3ème Trimestre</option>
            </select>
            <button type="submit" class="btn btn-primary">Filtrer</button>
        </div>
    </form>

    {% if is_granted('ROLE_DIRECTEUR') and classes|length > 0 %}
    <div class="mb-4 p-3 bg-green-50 rounded border border-green-200">
        <p class="text-sm font-semibold text-green-800 mb-2">Générer les bulletins pour une classe :</p>
        <form method="post" action="{{ path('app_bulletin_generer_classe') }}" class="flex gap-2 items-center flex-wrap">
            <select name="classeId" class="form-select w-auto" required>
                <option value="">— Sélectionner une classe —</option>
                {% for classe in classes %}
                    <option value="{{ classe.id }}">{{ classe.nom }}</option>
                {% endfor %}
            </select>
            <select name="periode" class="form-select w-auto" required>
                <option value="">— Période —</option>
                <option value="1">1er Trimestre</option>
                <option value="2">2ème Trimestre</option>
                <option value="3">3ème Trimestre</option>
            </select>
            <button type="submit" class="btn btn-success" onclick="return confirm('Générer / régénérer les bulletins pour cette classe ?')">
                Générer les bulletins
            </button>
        </form>
    </div>
    {% endif %}

    <div class="table-responsive">
        <table class="table table-hover" data-dt>
            <thead>
                <tr>
                    <th>Élève</th>
                    <th>Classe</th>
                    <th>Rang</th>
                    <th>Moyenne</th>
                    <th>Mention</th>
                    <th>Statut</th>
                    <th>Généré le</th>
                    <th class="no-export">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for bulletin in bulletins %}
                <tr>
                    <td>{{ bulletin.eleve.nomComplet }}</td>
                    <td>{{ bulletin.classe.nom }}</td>
                    <td>{{ bulletin.rangClasse ? bulletin.rangClasse ~ 'e' : '—' }}</td>
                    <td><strong>{{ bulletin.moyenneGenerale ? bulletin.moyenneGenerale|number_format(2) : '—' }}</strong> / 20</td>
                    <td>
                        {% set mention = bulletin.mention %}
                        {% if mention == 'Excellent' %}
                            <span class="px-2 py-1 rounded text-sm bg-green-100 text-green-800">{{ mention }}</span>
                        {% elseif mention == 'Très Bien' %}
                            <span class="px-2 py-1 rounded text-sm bg-teal-100 text-teal-800">{{ mention }}</span>
                        {% elseif mention == 'Bien' %}
                            <span class="px-2 py-1 rounded text-sm bg-blue-100 text-blue-800">{{ mention }}</span>
                        {% elseif mention == 'Assez Bien' %}
                            <span class="px-2 py-1 rounded text-sm bg-yellow-100 text-yellow-800">{{ mention }}</span>
                        {% elseif mention == 'Passable' %}
                            <span class="px-2 py-1 rounded text-sm bg-orange-100 text-orange-800">{{ mention }}</span>
                        {% elseif mention == 'Échec' %}
                            <span class="px-2 py-1 rounded text-sm bg-red-100 text-red-800">{{ mention }}</span>
                        {% else %}
                            <span class="px-2 py-1 rounded text-sm bg-gray-100 text-gray-800">{{ mention ?? '—' }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if bulletin.statut == 'validé' %}
                            <span class="px-2 py-1 rounded text-sm bg-green-100 text-green-800">Validé</span>
                        {% elseif bulletin.statut == 'distribué' %}
                            <span class="px-2 py-1 rounded text-sm bg-blue-100 text-blue-800">Distribué</span>
                        {% else %}
                            <span class="px-2 py-1 rounded text-sm bg-gray-100 text-gray-600">Brouillon</span>
                        {% endif %}
                    </td>
                    <td>{{ bulletin.genereAt ? bulletin.genereAt|date('d/m/Y H:i') : '—' }}</td>
                    <td class="flex gap-1">
                        <a class="btn btn-primary btn-sm" href="{{ path('app_bulletin_show', {'id': bulletin.id}) }}" data-tip="Voir"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg></a>
                        <a class="btn btn-secondary btn-sm" href="{{ path('app_bulletin_pdf', {'id': bulletin.id}) }}" target="_blank" data-tip="Télécharger le PDF"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg></a>
                        {% if is_granted('ROLE_DIRECTEUR') and bulletin.statut != 'validé' %}
                            <form method="post" action="{{ path('app_bulletin_valider', {'id': bulletin.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ bulletin.id) }}">
                                <button class="btn btn-success btn-sm" type="submit" data-tip="Valider le bulletin"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></button>
                            </form>
                        {% endif %}
                        {% if is_granted('ROLE_DIRECTEUR') %}
                            <form method="post" action="{{ path('app_bulletin_delete', {'id': bulletin.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bulletin.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit" data-tip="Supprimer" onclick="return confirm('Supprimer ce bulletin ?')"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">Aucun bulletin trouvé. Sélectionnez une classe et une période pour filtrer.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
