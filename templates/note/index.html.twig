{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Notes</h1>
        {% if is_granted('ROLE_SECRETAIRE') %}
            <a class="btn btn-primary" href="{{ path('app_note_new') }}">Saisir une note</a>
        {% endif %}
    </div>
</div>

<div class="panel">
    <form method="get" class="mb-4">
        <div class="flex gap-2 items-center flex-wrap">
            <label class="form-label mb-0">Classe :</label>
            <select name="classeId" class="form-select w-auto">
                <option value="">Toutes les classes</option>
                {% for classe in classes %}
                    <option value="{{ classe.id }}" {% if classeId == classe.id ~ '' %}selected{% endif %}>
                        {{ classe.nom }}
                    </option>
                {% endfor %}
            </select>
            <label class="form-label mb-0">Période :</label>
            <select name="periode" class="form-select w-auto">
                <option value="0">Toutes</option>
                <option value="1" {% if periode == 1 %}selected{% endif %}>1er Trimestre</option>
                <option value="2" {% if periode == 2 %}selected{% endif %}>2ème Trimestre</option>
                <option value="3" {% if periode == 3 %}selected{% endif %}>3ème Trimestre</option>
            </select>
            <button type="submit" class="btn btn-primary">Filtrer</button>
        </div>
    </form>

    {% if is_granted('ROLE_SECRETAIRE') and classes|length > 0 %}
    <div class="mb-4 p-3 bg-blue-50 rounded border border-blue-200">
        <p class="text-sm font-semibold text-blue-800 mb-2">Saisie en masse par classe :</p>
        <div class="flex gap-2 flex-wrap">
            {% for classe in classes %}
                {% for p in [1, 2, 3] %}
                    <a href="{{ path('app_note_saisie_classe', {'classeId': classe.id, 'periode': p}) }}"
                       class="text-xs px-2 py-1 bg-white border rounded hover:bg-blue-100">
                        {{ classe.nom }} — T{{ p }}
                    </a>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Élève</th>
                    <th>Matière</th>
                    <th>Note / Max</th>
                    <th>Période</th>
                    <th>Examen</th>
                    <th>Saisi par</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for note in notes %}
                <tr>
                    <td>{{ note.eleve.nomComplet }}</td>
                    <td>{{ note.matiere.nom }}</td>
                    <td>
                        <strong>{{ note.valeur|number_format(2) }}</strong>
                        <span class="text-gray-500">/ {{ note.valeurMax|number_format(2) }}</span>
                    </td>
                    <td>
                        {% if note.periode == 1 %}1er Trim.
                        {% elseif note.periode == 2 %}2ème Trim.
                        {% else %}3ème Trim.{% endif %}
                    </td>
                    <td>{{ note.examen ? note.examen.libelle : '—' }}</td>
                    <td>{{ note.saisiePar ?? '—' }}</td>
                    <td class="flex gap-1">
                        {% if is_granted('ROLE_SECRETAIRE') %}
                            <a class="btn btn-primary btn-sm" href="{{ path('app_note_edit', {'id': note.id}) }}" data-tip="Modifier"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                            <form method="post" action="{{ path('app_note_delete', {'id': note.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ note.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit" data-tip="Supprimer"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucune note trouvée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
