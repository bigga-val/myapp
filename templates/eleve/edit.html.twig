{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Modifier — {{ eleve.nomComplet }}</h1>
        <div class="flex gap-2">
            <a class="btn btn-primary" href="{{ path('app_eleve_show', {'id': eleve.id}) }}">Voir la fiche</a>
            <a class="btn btn-primary" href="{{ path('app_eleve_index') }}">Voir la liste</a>
        </div>
    </div>
</div>

<div class="panel">
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            {% if eleve.photo %}
                <div class="mb-4 flex items-center gap-4">
                    <img src="{{ asset(eleve.photo) }}" class="w-20 h-20 rounded-full object-cover" alt="{{ eleve.nomComplet }}">
                    <div>
                        <p class="text-sm text-gray-600">Photo actuelle</p>
                        <p class="text-sm text-gray-400">Uploader une nouvelle photo pour remplacer celle-ci.</p>
                    </div>
                </div>
            {% endif %}

            {{ include('eleve/_form.html.twig') }}
        </div>
        <div class="col-md-1"></div>
    </div>
</div>

{% endblock %}
