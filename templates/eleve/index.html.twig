{% extends 'components/layout/default.html.twig' %}
{% block content %}

{# ── En-tête ───────────────────────────────────────────────────────────────── #}
<div class="panel">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold">Élèves</h1>
            <p class="text-sm text-gray-500 mt-0.5">{{ nbTotal }} élève(s) enregistré(s)</p>
        </div>
        {% if is_granted('ROLE_SECRETAIRE') %}
            <a class="btn btn-primary" href="{{ path('app_eleve_new') }}">+ Nouvel élève</a>
        {% endif %}
    </div>
</div>

{# ── Statistiques ──────────────────────────────────────────────────────────── #}
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
    <div class="panel text-center">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Total</p>
        <p class="text-3xl font-bold text-primary">{{ nbTotal }}</p>
    </div>
    <div class="panel text-center">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Garçons</p>
        <p class="text-3xl font-bold text-blue-500">{{ nbGarcons }}</p>
        <p class="text-xs text-gray-400">{{ nbTotal > 0 ? ((nbGarcons / nbTotal * 100)|number_format(0)) ~ '%' : '—' }}</p>
    </div>
    <div class="panel text-center">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Filles</p>
        <p class="text-3xl font-bold text-pink-500">{{ nbFilles }}</p>
        <p class="text-xs text-gray-400">{{ nbTotal > 0 ? ((nbFilles / nbTotal * 100)|number_format(0)) ~ '%' : '—' }}</p>
    </div>
    <div class="panel text-center">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Avec photo</p>
        <p class="text-3xl font-bold text-success">{{ avecPhoto }}</p>
        <p class="text-xs text-gray-400">{{ nbTotal > 0 ? ((avecPhoto / nbTotal * 100)|number_format(0)) ~ '%' : '—' }}</p>
    </div>
</div>

{# ── Tableau ───────────────────────────────────────────────────────────────── #}
<div class="panel">
    <div class="table-responsive">
        <table class="table table-hover w-full" data-dt>
            <thead>
                <tr>
                    <th class="no-export">Photo</th>
                    <th>Matricule</th>
                    <th>Nom complet</th>
                    <th>Sexe</th>
                    <th>Tuteur</th>
                    <th>Date enreg.</th>
                    <th class="no-export">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for eleve in eleves %}
                <tr>
                    <td data-order="">
                        {% if eleve.photo %}
                            <img src="{{ asset(eleve.photo) }}" class="w-8 h-8 rounded-full object-cover" alt="{{ eleve.nomComplet }}">
                        {% else %}
                            <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-semibold text-gray-600">
                                {{ eleve.nom ? eleve.nom|slice(0,1)|upper : '?' }}
                            </div>
                        {% endif %}
                    </td>
                    <td>{{ eleve.matricule ?? '—' }}</td>
                    <td>{{ eleve.nomComplet }}</td>
                    <td data-order="{{ eleve.sexe }}">
                        {% if eleve.sexe == 'M' %}
                            <span class="px-2 py-0.5 rounded text-xs bg-blue-100 text-blue-800">Masculin</span>
                        {% else %}
                            <span class="px-2 py-0.5 rounded text-xs bg-pink-100 text-pink-800">Féminin</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if eleve.nomTuteur %}
                            {{ eleve.nomTuteur }}{% if eleve.telephoneTuteur %} · <small class="text-gray-500">{{ eleve.telephoneTuteur }}</small>{% endif %}
                        {% else %}—{% endif %}
                    </td>
                    <td data-order="{{ eleve.createdAt ? eleve.createdAt|date('Y-m-d') : '' }}">
                        {{ eleve.createdAt ? eleve.createdAt|date('d/m/Y') : '—' }}
                    </td>
                    <td data-export="">
                        <a class="btn btn-primary btn-sm" href="{{ path('app_eleve_show', {'id': eleve.id}) }}" data-tip="Voir"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg></a>
                        {% if is_granted('ROLE_SECRETAIRE') %}
                            <a class="btn btn-warning btn-sm" href="{{ path('app_eleve_edit', {'id': eleve.id}) }}" data-tip="Modifier">✎</a>
                            <form method="post" action="{{ path('app_eleve_delete', {'id': eleve.id}) }}" style="display:inline"
                                  data-confirm="Supprimer cet élève ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ eleve.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit" data-tip="Supprimer">✕</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>


{% endblock %}
