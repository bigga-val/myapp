{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between items-center mb-1">
        <h1>Fiche élève</h1>
        <a class="btn btn-primary" href="{{ path('app_eleve_index') }}">← Retour</a>
    </div>
</div>

{# ── Profil ─────────────────────────────────────────────────────────────── #}
<div class="panel mt-4">
    <div class="flex flex-col md:flex-row gap-6">

        {# Avatar + actions #}
        <div class="flex flex-col items-center text-center" style="min-width:160px;">
            {% if eleve.photo %}
                <img src="{{ asset(eleve.photo) }}"
                     class="rounded-full object-cover border-4 border-primary shadow"
                     style="width:120px;height:120px;"
                     alt="{{ eleve.nomComplet }}">
            {% else %}
                <div class="rounded-full flex items-center justify-center border-4 border-primary shadow text-3xl font-bold"
                     style="width:120px;height:120px;background:#e8eeff;color:#4361ee;">
                    {{ eleve.prenom|slice(0,1)|upper }}{{ eleve.nom|slice(0,1)|upper }}
                </div>
            {% endif %}

            <p class="mt-3 font-bold text-lg leading-tight">{{ eleve.nomComplet }}</p>
            <span class="mt-1 px-3 py-0.5 rounded-full text-xs font-mono bg-blue-100 text-blue-700 font-semibold">
                {{ eleve.matricule ?? 'Sans matricule' }}
            </span>
            <span class="mt-2 text-sm text-gray-500">
                {{ eleve.sexe == 'M' ? '👦 Masculin' : '👧 Féminin' }}
            </span>

            <div class="flex flex-col gap-2 mt-4 w-full">
                {% if is_granted('ROLE_SECRETAIRE') %}
                    <a class="btn btn-primary btn-sm" href="{{ path('app_eleve_edit', {'id': eleve.id}) }}">✏ Modifier</a>
                    <a class="btn btn-success btn-sm" href="{{ path('app_inscription_new', {'eleveId': eleve.id}) }}">+ Inscrire</a>
                {% endif %}
            </div>
        </div>

        {# Infos détaillées #}
        <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-0">

            {# ── Infos personnelles #}
            <div>
                <h3 class="text-xs font-bold uppercase tracking-widest text-primary mb-3 border-b border-primary/20 pb-1">
                    Informations personnelles
                </h3>
                <div class="space-y-2">
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Nom</span>
                        <span class="font-medium text-sm">{{ eleve.nom }}</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Post-nom</span>
                        <span class="font-medium text-sm">{{ eleve.postnom ?? '—' }}</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Prénom</span>
                        <span class="font-medium text-sm">{{ eleve.prenom }}</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Date de naissance</span>
                        <span class="font-medium text-sm">{{ eleve.dateNaissance ? eleve.dateNaissance|date('d/m/Y') : '—' }}</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Lieu de naissance</span>
                        <span class="font-medium text-sm">{{ eleve.lieuNaissance ?? '—' }}</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Adresse</span>
                        <span class="font-medium text-sm">{{ eleve.adresse ?? '—' }}</span>
                    </div>
                </div>
            </div>

            {# ── Infos tuteur #}
            <div class="mt-5 md:mt-0">
                <h3 class="text-xs font-bold uppercase tracking-widest text-primary mb-3 border-b border-primary/20 pb-1">
                    Informations du tuteur
                </h3>
                <div class="space-y-2">
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Nom du tuteur</span>
                        <span class="font-medium text-sm">{{ eleve.nomTuteur ?? '—' }}</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Relation</span>
                        <span class="font-medium text-sm">{{ eleve.relationTuteur ?? '—' }}</span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Téléphone</span>
                        <span class="font-medium text-sm">
                            {% if eleve.telephoneTuteur %}
                                <a href="tel:{{ eleve.telephoneTuteur }}" class="text-primary hover:underline">{{ eleve.telephoneTuteur }}</a>
                            {% else %}—{% endif %}
                        </span>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-gray-400 text-sm w-32 shrink-0">Email</span>
                        <span class="font-medium text-sm">
                            {% if eleve.emailTuteur %}
                                <a href="mailto:{{ eleve.emailTuteur }}" class="text-primary hover:underline">{{ eleve.emailTuteur }}</a>
                            {% else %}—{% endif %}
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{# Inscriptions section #}
<div class="panel mt-4">
    <h3 class="mb-3 font-semibold text-lg">Inscriptions</h3>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Année académique</th>
                    <th>Classe</th>
                    <th>Niveau</th>
                    <th>Statut</th>
                    <th>Date inscription</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for inscription in inscriptions %}
                <tr>
                    <td>{{ inscription.anneeAcademique.libelle }}</td>
                    <td>{{ inscription.classe.nom }}</td>
                    <td>{{ inscription.classe.niveau.label() }}</td>
                    <td>
                        {% if inscription.statut == 'actif' %}
                            <span class="px-2 py-1 rounded text-sm bg-green-100 text-green-800">Actif</span>
                        {% elseif inscription.statut == 'transféré' %}
                            <span class="px-2 py-1 rounded text-sm bg-yellow-100 text-yellow-800">Transféré</span>
                        {% elseif inscription.statut == 'exclu' %}
                            <span class="px-2 py-1 rounded text-sm bg-red-100 text-red-800">Exclu</span>
                        {% elseif inscription.statut == 'diplômé' %}
                            <span class="px-2 py-1 rounded text-sm bg-blue-100 text-blue-800">Diplômé</span>
                        {% else %}
                            <span class="px-2 py-1 rounded text-sm bg-gray-100 text-gray-800">{{ inscription.statut }}</span>
                        {% endif %}
                    </td>
                    <td>{{ inscription.dateInscription ? inscription.dateInscription|date('d/m/Y') : '—' }}</td>
                    <td class="flex gap-1">
                        {% if is_granted('ROLE_SECRETAIRE') %}
                            <a class="btn btn-primary btn-sm" href="{{ path('app_inscription_edit', {'id': inscription.id}) }}" data-tip="Modifier"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                            <form method="post" action="{{ path('app_inscription_delete', {'id': inscription.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ inscription.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit" data-tip="Supprimer" onclick="return confirm('Supprimer cette inscription ?')"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucune inscription.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── Paiement groupé ───────────────────────────────────────────────────────── #}
{% if fraisEligibles is not empty and is_granted('ROLE_SECRETAIRE') %}
<div class="panel mt-4">
    <h3 class="font-semibold text-lg mb-3">Enregistrer un paiement</h3>
    <form method="post" action="{{ path('app_paiement_frais_batch') }}">
        <input type="hidden" name="eleveId" value="{{ eleve.id }}">

        <p class="text-sm text-gray-500 mb-3">Sélectionnez les frais à payer (montants modifiables) :</p>

        <div class="space-y-2 mb-4">
            {% for f in fraisEligibles %}
            <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                <input type="checkbox" name="fraisIds[]" value="{{ f.id }}" checked
                       class="w-4 h-4 text-primary rounded">
                <span class="flex-1 font-medium text-sm">{{ f.libelle }}</span>
                <span class="text-sm text-success font-semibold">{{ f.montant|number_format(0, ',', ' ') }} FC</span>
            </label>
            {% endfor %}
        </div>

        <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
                <label class="form-label">Date de paiement</label>
                <input type="date" name="datePaiement" class="form-input"
                       value="{{ 'now'|date('Y-m-d') }}" required>
            </div>
            <div>
                <label class="form-label">Mode de paiement</label>
                <select name="modePaiement" class="form-select">
                    <option value="especes">Espèces</option>
                    <option value="mobile_money">Mobile Money</option>
                    <option value="virement">Virement</option>
                    <option value="cheque">Chèque</option>
                </select>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label">Observations <span class="text-gray-400 text-xs">(optionnel)</span></label>
            <textarea name="observations" class="form-input" rows="2"></textarea>
        </div>

        <button type="submit" class="btn btn-success">
            Enregistrer et imprimer le reçu
        </button>
    </form>
</div>
{% elseif is_granted('ROLE_SECRETAIRE') %}
<div class="panel mt-4 bg-green-50 border border-green-200">
    <p class="text-green-700 text-sm font-medium">✓ Tous les frais de l'année courante ont été payés.</p>
</div>
{% endif %}

{# Paiements section #}
<div class="panel mt-4">
    <div class="flex justify-between items-center mb-3">
        <h3 class="font-semibold text-lg">Historique des paiements</h3>
        {% if is_granted('ROLE_SECRETAIRE') %}
            <a href="{{ path('app_paiement_frais_new') }}" class="btn btn-success btn-sm">+ Nouveau paiement</a>
        {% endif %}
    </div>
    {% if paiements is empty %}
        <p class="text-gray-400 text-sm">Aucun paiement enregistré.</p>
    {% else %}
        <form method="get" action="{{ path('app_paiement_frais_recu_multiple') }}" id="form-recu-multiple">
        <div class="table-responsive">
            <table class="table table-hover text-sm">
                <thead>
                    <tr>
                        <th class="no-export w-8">
                            <input type="checkbox" id="check-all" class="w-4 h-4 rounded" data-tip="Tout sélectionner">
                        </th>
                        <th>Reçu</th>
                        <th>Frais</th>
                        <th class="text-right">Montant</th>
                        <th>Mode</th>
                        <th>Date</th>
                        <th>Enregistré par</th>
                        <th class="no-export"></th>
                    </tr>
                </thead>
                <tbody>
                {% set totalPaye = 0 %}
                {% for p in paiements %}
                    {% set totalPaye = totalPaye + p.montantPaye %}
                    <tr>
                        <td class="no-export">
                            <input type="checkbox" name="ids[]" value="{{ p.id }}" class="w-4 h-4 rounded paiement-check">
                        </td>
                        <td class="font-mono text-xs text-gray-500">{{ p.numeroRecu }}</td>
                        <td>{{ p.fraisScolaire.libelle }}</td>
                        <td class="text-right font-semibold text-success">{{ p.montantPaye|number_format(0, ',', ' ') }} FC</td>
                        <td>
                            {% if p.modePaiement == 'mobile_money' %}
                                <span class="px-1.5 py-0.5 rounded text-xs bg-purple-100 text-purple-700">Mobile</span>
                            {% elseif p.modePaiement == 'virement' %}
                                <span class="px-1.5 py-0.5 rounded text-xs bg-blue-100 text-blue-700">Virement</span>
                            {% elseif p.modePaiement == 'cheque' %}
                                <span class="px-1.5 py-0.5 rounded text-xs bg-yellow-100 text-yellow-700">Chèque</span>
                            {% else %}
                                <span class="px-1.5 py-0.5 rounded text-xs bg-gray-100 text-gray-600">Espèces</span>
                            {% endif %}
                        </td>
                        <td>{{ p.datePaiement ? p.datePaiement|date('d/m/Y') : '—' }}</td>
                        <td class="text-gray-400 text-xs">{{ p.enregistrePar }}</td>
                        <td class="no-export">
                            <a href="{{ path('app_paiement_frais_pdf', {'id': p.id}) }}" class="btn btn-sm btn-secondary text-xs" data-tip="Imprimer le reçu individuel">🖨</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="font-semibold bg-gray-50">
                        <td></td>
                        <td colspan="2" class="text-right text-gray-600">Total payé</td>
                        <td class="text-right text-success">{{ totalPaye|number_format(0, ',', ' ') }} FC</td>
                        <td colspan="4"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="flex items-center gap-3 mt-3">
            <button type="submit" class="btn btn-primary btn-sm" id="btn-recu-multiple" disabled>
                🖨 Imprimer reçu groupé (<span id="nb-selected">0</span> sélectionné(s))
            </button>
            <span class="text-xs text-gray-400">Cochez les paiements à inclure dans le reçu</span>
        </div>
        </form>
    {% endif %}
</div>

{% endblock %}

{% block extra_scripts %}
<script>
(function () {
    function updateBtn() {
        var n = document.querySelectorAll('.paiement-check:checked').length;
        document.getElementById('nb-selected').textContent = n;
        document.getElementById('btn-recu-multiple').disabled = (n === 0);
    }

    var checkAll = document.getElementById('check-all');
    if (!checkAll) return;

    checkAll.addEventListener('change', function () {
        document.querySelectorAll('.paiement-check').forEach(function (cb) {
            cb.checked = checkAll.checked;
        });
        updateBtn();
    });

    document.querySelectorAll('.paiement-check').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var total   = document.querySelectorAll('.paiement-check').length;
            var checked = document.querySelectorAll('.paiement-check:checked').length;
            checkAll.indeterminate = (checked > 0 && checked < total);
            checkAll.checked = (checked === total);
            updateBtn();
        });
    });
})();
</script>
{% endblock %}
