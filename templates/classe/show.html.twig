{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Classe — {{ classe.nom }}</h1>
        <div class="flex gap-2">
            <a class="btn btn-primary" href="{{ path('app_classe_edit', {'id': classe.id}) }}">Modifier</a>
            <a class="btn btn-primary" href="{{ path('app_classe_index') }}">Retour à la liste</a>
        </div>
    </div>
</div>

<div class="panel">
    <table class="table">
        <tbody>
            <tr>
                <th class="w-1/3">Nom</th>
                <td>{{ classe.nom }}</td>
            </tr>
            <tr>
                <th>Niveau</th>
                <td>
                    <span class="px-2 py-1 rounded text-sm {{ classe.niveau.badgeClass() }}">
                        {{ classe.niveau.label() }}
                    </span>
                </td>
            </tr>
            <tr>
                <th>Année académique</th>
                <td>{{ classe.anneeAcademique ? classe.anneeAcademique.libelle : '—' }}</td>
            </tr>
            <tr>
                <th>Salle</th>
                <td>{{ classe.salle ?? '—' }}</td>
            </tr>
            <tr>
                <th>Effectif maximum</th>
                <td>{{ classe.effectifMax ?? '—' }}</td>
            </tr>
            <tr>
                <th>Créée le</th>
                <td>{{ classe.createdAt ? classe.createdAt|date('d/m/Y') : '' }}</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="panel">
    <div class="mb-3">
        <h2 class="text-lg font-semibold">Élèves inscrits dans cette classe</h2>
    </div>
    <p class="text-gray-500">Aucun élève inscrit pour le moment.</p>
</div>

{% endblock %}
