{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Liste des classes</h1>
        <a class="btn btn-primary" href="{{ path('app_classe_new') }}">Nouvelle classe</a>
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-hover" data-dt>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nom</th>
                    <th>Niveau</th>
                    <th>Année académique</th>
                    <th>Salle</th>
                    <th>Effectif max</th>
                    <th class="no-export">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for classe in classes %}
                <tr>
                    <td>{{ classe.id }}</td>
                    <td>{{ classe.nom }}</td>
                    <td>
                        {% set niveau = classe.niveau.value %}
                        {% if niveau == 'maternelle' %}
                            <span class="px-2 py-1 rounded text-sm bg-pink-100 text-pink-800">{{ classe.niveau.label() }}</span>
                        {% elseif niveau == 'primaire' %}
                            <span class="px-2 py-1 rounded text-sm bg-blue-100 text-blue-800">{{ classe.niveau.label() }}</span>
                        {% elseif niveau == 'secondaire' %}
                            <span class="px-2 py-1 rounded text-sm bg-green-100 text-green-800">{{ classe.niveau.label() }}</span>
                        {% else %}
                            <span class="px-2 py-1 rounded text-sm bg-purple-100 text-purple-800">{{ classe.niveau.label() }}</span>
                        {% endif %}
                    </td>
                    <td>{{ classe.anneeAcademique ? classe.anneeAcademique.libelle : '' }}</td>
                    <td>{{ classe.salle ?? '—' }}</td>
                    <td>{{ classe.effectifMax ?? '—' }}</td>
                    <td class="flex gap-1">
                        <a class="btn btn-primary btn-sm" href="{{ path('app_classe_show', {'id': classe.id}) }}" data-tip="Voir le détail"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg></a>
                        <a class="btn btn-primary btn-sm" href="{{ path('app_classe_edit', {'id': classe.id}) }}" data-tip="Modifier"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                        <form method="post" action="{{ path('app_classe_delete', {'id': classe.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ classe.id) }}">
                            <button class="btn btn-danger btn-sm" type="submit" data-tip="Supprimer"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucune classe trouvée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
