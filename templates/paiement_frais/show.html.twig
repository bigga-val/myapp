{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1>Détail du paiement</h1>
        <div class="flex gap-2">
            <a href="{{ path('app_paiement_frais_pdf', {'id': paiement.id}) }}" target="_blank" class="btn btn-primary">
                Télécharger le reçu PDF
            </a>
            <a href="{{ path('app_paiement_frais_index') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>

    <div class="bg-gray-50 rounded-lg p-4 mb-4">
        <div class="text-center mb-4">
            <span class="font-mono text-lg font-bold bg-blue-100 text-blue-800 px-3 py-1 rounded">
                {{ paiement.numeroRecu }}
            </span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <p class="text-sm text-gray-500">Élève</p>
                <p class="font-medium">{{ paiement.eleve.nomComplet }}</p>
                <p class="text-sm text-gray-500 font-mono">{{ paiement.eleve.matricule ?? '—' }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Frais scolaire</p>
                <p class="font-medium">{{ paiement.fraisScolaire.libelle }}</p>
                <p class="text-sm text-gray-500">{{ paiement.fraisScolaire.anneeAcademique.libelle }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Montant payé</p>
                <p class="font-bold text-lg">{{ paiement.montantPaye|number_format(2, ',', ' ') }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Date de paiement</p>
                <p class="font-medium">{{ paiement.datePaiement ? paiement.datePaiement|date('d/m/Y') : '—' }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Mode de paiement</p>
                <p class="font-medium">
                    {% if paiement.modePaiement == 'especes' %}Espèces
                    {% elseif paiement.modePaiement == 'mobile_money' %}Mobile Money
                    {% elseif paiement.modePaiement == 'virement' %}Virement bancaire
                    {% elseif paiement.modePaiement == 'cheque' %}Chèque
                    {% else %}{{ paiement.modePaiement }}{% endif %}
                </p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Enregistré par</p>
                <p class="font-medium">{{ paiement.enregistrePar ?? '—' }}</p>
            </div>
        </div>

        {% if paiement.observations %}
            <div class="mt-4">
                <p class="text-sm text-gray-500">Observations</p>
                <p class="text-gray-700">{{ paiement.observations }}</p>
            </div>
        {% endif %}

        <div class="mt-4 pt-4 border-t border-gray-200 text-sm text-gray-400">
            Enregistré le {{ paiement.createdAt ? paiement.createdAt|date('d/m/Y à H:i') : '—' }}
        </div>
    </div>

    {% if is_granted('ROLE_SECRETAIRE') %}
        <form method="post" action="{{ path('app_paiement_frais_delete', {'id': paiement.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ paiement.id) }}">
            <button class="btn btn-danger btn-sm" type="submit" onclick="return confirm('Supprimer ce paiement ?')">
                Supprimer ce paiement
            </button>
        </form>
    {% endif %}
</div>

{% endblock %}
