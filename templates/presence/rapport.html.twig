{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between items-center mb-3">
        <h1>Rapport de présence — {{ eleve.nomComplet }}</h1>
        <a class="btn btn-secondary" href="{{ path('app_presence_index') }}">Retour</a>
    </div>
    <p class="text-sm text-gray-500">
        Période : {{ debut|date('d/m/Y') }} → {{ fin|date('d/m/Y') }}
    </p>
</div>

<div class="panel mb-3">
    <form method="get" class="flex gap-2 items-center flex-wrap">
        <label class="form-label mb-0">Du :</label>
        <input type="date" name="debut" class="form-input w-auto" value="{{ debut|date('Y-m-d') }}">
        <label class="form-label mb-0">Au :</label>
        <input type="date" name="fin" class="form-input w-auto" value="{{ fin|date('Y-m-d') }}">
        <button type="submit" class="btn btn-primary">Filtrer</button>
    </form>
</div>

<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-4">
    <div class="panel text-center">
        <div class="text-2xl font-bold">{{ stats.total }}</div>
        <div class="text-sm text-gray-500">Total enregistré</div>
    </div>
    <div class="panel text-center border-l-4 border-green-500">
        <div class="text-2xl font-bold text-green-600">{{ stats.present }}</div>
        <div class="text-sm text-gray-500">Présent</div>
    </div>
    <div class="panel text-center border-l-4 border-red-500">
        <div class="text-2xl font-bold text-red-600">{{ stats.absent }}</div>
        <div class="text-sm text-gray-500">Absent</div>
    </div>
    <div class="panel text-center border-l-4 border-yellow-500">
        <div class="text-2xl font-bold text-yellow-600">{{ stats.retard }}</div>
        <div class="text-sm text-gray-500">Retard</div>
    </div>
    <div class="panel text-center border-l-4 border-blue-500">
        <div class="text-2xl font-bold text-blue-600">{{ stats.justifie }}</div>
        <div class="text-sm text-gray-500">Justifié</div>
    </div>
</div>

<div class="panel">
    {% if presences|length == 0 %}
        <p class="text-gray-500 text-center py-4">Aucun enregistrement pour cette période.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Motif</th>
                        <th>Saisi par</th>
                    </tr>
                </thead>
                <tbody>
                {% for presence in presences %}
                    <tr>
                        <td>{{ presence.date|date('d/m/Y') }}</td>
                        <td>
                            {% if presence.statut == 'present' %}
                                <span class="badge bg-success text-white px-2 py-1 rounded text-xs">Présent</span>
                            {% elseif presence.statut == 'absent' %}
                                <span class="badge bg-danger text-white px-2 py-1 rounded text-xs">Absent</span>
                            {% elseif presence.statut == 'retard' %}
                                <span class="badge bg-warning text-white px-2 py-1 rounded text-xs">Retard</span>
                            {% elseif presence.statut == 'justifié' %}
                                <span class="badge bg-info text-white px-2 py-1 rounded text-xs">Justifié</span>
                            {% else %}
                                <span class="badge bg-secondary text-white px-2 py-1 rounded text-xs">{{ presence.statut }}</span>
                            {% endif %}
                        </td>
                        <td>{{ presence.motif ?? '—' }}</td>
                        <td>{{ presence.saisiePar ?? '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{% endblock %}
