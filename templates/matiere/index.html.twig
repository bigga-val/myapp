{% extends 'components/layout/default.html.twig' %}
{% block content %}

<div class="panel">
    <div class="flex justify-between mb-3">
        <h1>Matières</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-primary" href="{{ path('app_matiere_new') }}">Nouvelle matière</a>
        {% endif %}
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-hover" data-dt>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nom</th>
                    <th>Code</th>
                    <th>Coefficient</th>
                    <th>Niveau</th>
                    <th>Date</th>
                    <th class="no-export">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for matiere in matieres %}
                <tr>
                    <td>{{ matiere.id }}</td>
                    <td>{{ matiere.nom }}</td>
                    <td>{{ matiere.code ?? '—' }}</td>
                    <td>{{ matiere.coefficient }}</td>
                    <td>
                        <span class="px-2 py-1 rounded text-sm {{ matiere.niveau.badgeClass() }}">
                            {{ matiere.niveau.label() }}
                        </span>
                    </td>
                    <td>{{ matiere.createdAt ? matiere.createdAt|date('d/m/Y') : '' }}</td>
                    <td class="flex gap-1">
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="btn btn-primary btn-sm" href="{{ path('app_matiere_edit', {'id': matiere.id}) }}" data-tip="Modifier"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                            <form method="post" action="{{ path('app_matiere_delete', {'id': matiere.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ matiere.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit" data-tip="Supprimer" onclick="return confirm('Supprimer cette matière ?')"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucune matière trouvée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
