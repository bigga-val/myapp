{% extends 'components/layout/default.html.twig' %}
{% block content %}

{# ===== HEADER ===== #}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Tableau de bord</h1>
        <p class="text-sm text-gray-500">{{ moisCourant }}</p>
    </div>
    <a href="{{ path('app_audit_log_index') }}" class="btn btn-outline-primary text-sm">
        Journal d'audit
    </a>
</div>

{# ===== KPI CARDS ===== #}
<div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

    <a href="{{ path('app_eleve_index') }}" class="panel bg-gradient-to-r from-blue-500 to-blue-600 text-white block">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Élèves inscrits</div>
        <div class="text-2xl font-bold">{{ nbEleves }}</div>
        <div class="text-xs opacity-70 mt-1">Voir la liste</div>
    </a>

    <a href="{{ path('app_employe_index') }}" class="panel bg-gradient-to-r from-violet-500 to-violet-600 text-white block">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Enseignants</div>
        <div class="text-2xl font-bold">{{ nbEnseignants }}</div>
        <div class="text-xs opacity-70 mt-1">Voir la liste</div>
    </a>

    <a href="{{ path('app_classe_index') }}" class="panel bg-gradient-to-r from-teal-500 to-teal-600 text-white block">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Classes</div>
        <div class="text-2xl font-bold">{{ nbClasses }}</div>
        <div class="text-xs opacity-70 mt-1">Voir les classes</div>
    </a>

    <div class="panel bg-gradient-to-r from-emerald-500 to-emerald-600 text-white">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Frais perçus ce mois</div>
        <div class="text-2xl font-bold">{{ fraisPercusMois|number_format(0, ',', ' ') }} FC</div>
        <div class="text-xs opacity-70 mt-1">Paiements reçus</div>
    </div>

    <div class="panel {% if fraisEnAttente > 0 %}bg-gradient-to-r from-orange-400 to-orange-500{% else %}bg-gradient-to-r from-gray-400 to-gray-500{% endif %} text-white">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Paiements en attente</div>
        <div class="text-2xl font-bold">{{ fraisEnAttente }}</div>
        <div class="text-xs opacity-70 mt-1">
            <span class="opacity-70">Disponible en Phase 5</span>
        </div>
    </div>

    <div class="panel bg-gradient-to-r from-indigo-500 to-indigo-600 text-white">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Livres empruntés</div>
        <div class="text-2xl font-bold">{{ livresEmpruntes }}</div>
        <div class="text-xs opacity-70 mt-1">Disponible en Phase 6</div>
    </div>

    <div class="panel bg-gradient-to-r from-rose-500 to-rose-600 text-white">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Masse salariale</div>
        <div class="text-2xl font-bold">{{ masseSalariale|number_format(0, ',', ' ') }} FC</div>
        <div class="text-xs opacity-70 mt-1">Mois courant</div>
    </div>

    {% set solde = totalDebits - totalCredits %}
    <div class="panel {% if solde >= 0 %}bg-gradient-to-r from-green-500 to-green-600{% else %}bg-gradient-to-r from-red-500 to-red-600{% endif %} text-white">
        <div class="text-xs font-semibold uppercase opacity-80 mb-1">Solde</div>
        <div class="text-2xl font-bold">{{ solde|number_format(0, ',', ' ') }} FC</div>
        <div class="text-xs opacity-70 mt-1">Recettes − Dépenses</div>
    </div>

</div>

{# ===== JOURNAL D'AUDIT RÉCENT ===== #}
<div class="panel">
    <div class="flex justify-between items-center mb-3">
        <h5 class="font-semibold">Activité récente</h5>
        <a href="{{ path('app_audit_log_index') }}" class="text-primary text-sm hover:underline">Voir tout</a>
    </div>
    <table class="table text-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Utilisateur</th>
                <th>Entité</th>
                <th>Action</th>
                <th>IP</th>
            </tr>
        </thead>
        <tbody>
        {% for log in derniersLogs|slice(0, 8) %}
            <tr>
                <td class="whitespace-nowrap">{{ log.createdAt|date('d/m/Y H:i') }}</td>
                <td>{{ log.userEmail ?? '—' }}</td>
                <td><span class="badge bg-info">{{ log.entityName }}</span></td>
                <td>
                    {% if log.action == 'CREATE' %}
                        <span class="badge bg-success">CREATE</span>
                    {% elseif log.action == 'UPDATE' %}
                        <span class="badge bg-warning">UPDATE</span>
                    {% else %}
                        <span class="badge bg-danger">{{ log.action }}</span>
                    {% endif %}
                </td>
                <td class="text-gray-400">{{ log.ipAddress ?? '—' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-center text-gray-400">Aucune activité enregistrée</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
